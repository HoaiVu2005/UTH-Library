# Environment Configuration for UTH Library System
DEBUG=True
SECRET_KEY=uth-library-insecure-dev-secret-key-replace-in-production-2026
JWT_SECRET=uth-jwt-insecure-secret-key-change-me-in-production-2026
ALLOWED_HOSTS=localhost,127.0.0.1,backend,web
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:80

# Database (PostgreSQL 16)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/uth_library
# For Docker Compose:
# DATABASE_URL=postgres://uth_user:uth_password@db:5432/uth_library

# Timezone
TZ=Asia/Ho_Chi_Minh

# SMTP Email (Optional - notifications work in-app without SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_FROM=Thư viện UTH <library@uth.edu.vn>

